# Both values are intentionally browser-public. Never put a service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional for non-Pages hosting. Must start and end with a slash.
# VITE_BASE_PATH=/

# PostHog project (analytics). Both values are browser-public. The key must be
# a phc_ project key — never a personal API key, which would be shipped to
# every visitor. Leave both unset to run with analytics disabled.
VITE_POSTHOG_KEY=phc_your-project-api-key
VITE_POSTHOG_HOST=https://us.i.posthog.com
